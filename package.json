{
  "name": "@eriksremess/i18n",
  "description": "lightweight translation module with dynamic json storage",
  "version": "0.15.5",
  "homepage": "https://github.com/EriksRemess/i18n-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EriksRemess/i18n-node.git"
  },
  "author": "Ēriks Remess <eriks@remess.lv>",
  "contributors": [
    "Marcus Spiegel <marcus.spiegel@gmail.com>"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "imports": {
    "#lib/*": "./lib/*.js",
    "#i18n": "./index.js",
    "#package": "./package.json",
    "#test-setup": "./test/node-test-setup.js"
  },
  "files": [
    "i18n.js",
    "index.js",
    "lib"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "keywords": [
    "template",
    "i18n",
    "l10n"
  ],
  "directories": {
    "lib": "."
  },
  "dependencies": {
    "make-plural": "^8.2.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "bench": "npm --prefix ./bench run bench",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 --import '#test-setup' ./test/i18n*.js",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 --import '#test-setup' ./test/i18n*.js"
  },
  "license": "MIT"
}
